{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Experimental instance-sync-v1 input-lock-v0.1.0",
  "type": "object",
  "properties": {
    "lock_version": {
      "const": "0.1.0"
    },
    "profile": {
      "const": "instance-sync-v1"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "algorithm": {
            "const": "sha256"
          },
          "digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "length": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2147483647
          }
        },
        "required": [
          "id",
          "algorithm",
          "digest",
          "length"
        ],
        "additionalProperties": false
      }
    },
    "bindings": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "kind": {
                "const": "instance"
              },
              "from": {
                "type": "object",
                "properties": {
                  "component": {
                    "type": "string",
                    "minLength": 1
                  },
                  "port": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "component",
                  "port"
                ],
                "additionalProperties": false
              },
              "to": {
                "type": "object",
                "properties": {
                  "component": {
                    "type": "string",
                    "minLength": 1
                  },
                  "port": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "component",
                  "port"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "kind",
              "from",
              "to"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "const": "function"
              },
              "from": {
                "type": "object",
                "properties": {
                  "component": {
                    "type": "string",
                    "minLength": 1
                  },
                  "port": {
                    "type": "string",
                    "minLength": 1
                  },
                  "member": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "component",
                  "port"
                ],
                "additionalProperties": false
              },
              "to": {
                "type": "object",
                "properties": {
                  "component": {
                    "type": "string",
                    "minLength": 1
                  },
                  "port": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "component",
                  "port"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "kind",
              "from",
              "to"
            ],
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "required": [
    "lock_version",
    "profile",
    "artifacts",
    "bindings"
  ],
  "additionalProperties": false
}
