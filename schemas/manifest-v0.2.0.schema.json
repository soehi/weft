{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "enum": [
        "0.1.0",
        "0.2.0"
      ],
      "default": "0.2.0"
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^.]+$"
          },
          "path": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "name",
          "path"
        ],
        "additionalProperties": false
      }
    },
    "wires": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "from": {
            "type": "string",
            "pattern": "^[^.]+\\.[^.]+(?:\\.[^.]+)*$"
          },
          "to": {
            "type": "string",
            "pattern": "^[^.]+\\.[^.]+(?:\\.[^.]+)*$"
          }
        },
        "required": [
          "from",
          "to"
        ],
        "additionalProperties": false
      }
    },
    "resources": {
      "type": "object",
      "properties": {
        "max_memory_pages": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "quota": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        }
      },
      "required": [],
      "additionalProperties": false
    }
  },
  "required": [
    "components"
  ],
  "additionalProperties": false
}
