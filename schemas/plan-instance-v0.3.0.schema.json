{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Experimental instance-sync-v1 plan-instance-v0.3.0",
  "type": "object",
  "properties": {
    "plan_version": {
      "const": "0.3.0"
    },
    "profile": {
      "const": "instance-sync-v1"
    },
    "instances": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "order": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2147483647
          },
          "imports": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2147483647
            },
            "uniqueItems": true
          }
        },
        "required": [
          "name",
          "path",
          "order",
          "imports"
        ],
        "additionalProperties": false
      }
    },
    "bindings": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "kind": {
                "const": "instance"
              },
              "from": {
                "type": "object",
                "properties": {
                  "component": {
                    "type": "string",
                    "minLength": 1
                  },
                  "port": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "component",
                  "port"
                ],
                "additionalProperties": false
              },
              "to": {
                "type": "object",
                "properties": {
                  "component": {
                    "type": "string",
                    "minLength": 1
                  },
                  "port": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "component",
                  "port"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "kind",
              "from",
              "to"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "const": "function"
              },
              "from": {
                "type": "object",
                "properties": {
                  "component": {
                    "type": "string",
                    "minLength": 1
                  },
                  "port": {
                    "type": "string",
                    "minLength": 1
                  },
                  "member": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "component",
                  "port"
                ],
                "additionalProperties": false
              },
              "to": {
                "type": "object",
                "properties": {
                  "component": {
                    "type": "string",
                    "minLength": 1
                  },
                  "port": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "component",
                  "port"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "kind",
              "from",
              "to"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "operations": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "op": {
                "const": "instantiate"
              },
              "component": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "op",
              "component"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "op": {
                "const": "install-import"
              },
              "binding": {
                "type": "integer",
                "minimum": 0,
                "maximum": 2147483647
              }
            },
            "required": [
              "op",
              "binding"
            ],
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "required": [
    "plan_version",
    "profile",
    "instances",
    "bindings",
    "operations"
  ],
  "additionalProperties": false
}
