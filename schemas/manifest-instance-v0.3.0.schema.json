            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "name",
          "path"
        ],
        "additionalProperties": false
      }
    },
    "bindings": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "kind": {
                "const": "instance"
              },
              "from": {
                "type": "object",
                "properties": {
                  "component": {
                    "type": "string",
                    "minLength": 1
                  },
                  "port": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "component",
                  "port"
                ],
                "additionalProperties": false
              },
              "to": {
                "type": "object",
                "properties": {
                  "component": {
                    "type": "string",
                    "minLength": 1
                  },
                  "port": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "component",
                  "port"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "kind",
              "from",
              "to"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "const": "function"
              },
              "from": {
                "type": "object",
                "properties": {
                  "component": {
                    "type": "string",
                    "minLength": 1
                  },
                  "port": {
                    "type": "string",
                    "minLength": 1
                  },
                  "member": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "component",
                  "port"
                ],
                "additionalProperties": false
              },
              "to": {
                "type": "object",
                "properties": {
                  "component": {
                    "type": "string",
                    "minLength": 1
                  },
                  "port": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "component",
                  "port"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "kind",
              "from",
              "to"
            ],
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "required": [
    "manifest_version",
    "profile",
    "components",
    "bindings"
  ],
  "additionalProperties": false
}
