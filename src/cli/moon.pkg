import {
  "soehi/weft/api",
  "soehi/weft/manifest",
  "soehi/weft/plan",
  "soehi/weft/wac_adapter" @wac,
  "moonbitlang/core/env",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/json",
  "moonbitlang/x/fs",
  "moonbitlang/x/path",
  "moonbitlang/x/sys",
}

pkgtype(kind: "executable")

import {
  "Milky2018/wasm_component/text",
} for "wbtest"

options(
  targets: {
    "argv_js.mbt": [ "js" ],
    "argv_other.mbt": [ "native", "wasm", "wasm-gc" ],
  },
)
