// Experimental adapter; the separate runtime_probe also imports wasmoon.
//
// wasmoon's component runtime is `supported_targets = "+native"`, so this
// package is native-only. The experimental execute API is covered by Linux
// integration tests; the separate Linux experimental command accepts explicit targets.

import {
  "soehi/weft/exec_plan" @exec,
  "Milky2018/wasmoon/component/runtime_impl" @linker,
  "Milky2018/wasmoon/component_native" @native,
  "soehi/weft/api",
  "moonbitlang/x/sys",
  "moonbitlang/core/string" @strparse,
  "moonbitlang/core/env",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/x/fs",
  "moonbitlang/x/path",
  "soehi/weft/manifest",
}

pkgtype(kind: "executable")

supported_targets = "native"

import {
  "Milky2018/wasm_component/text",
} for "wbtest"
