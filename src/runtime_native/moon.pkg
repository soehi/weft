// The only code in this repository that imports `wasmoon`.
//
// wasmoon's component runtime is `supported_targets = "+native"`, so this
// package is native-only by construction. Execution is disabled until the E1
// probe establishes how to install cross-instance imports.

import {
  "soehi/weft/exec_plan" @exec,
  "soehi/weft/plan",
  "Milky2018/wasmoon/component",
  "moonbitlang/x/sys",
  "moonbitlang/core/string" @strparse,
}

pkgtype(kind: "executable")

supported_targets = "native"
