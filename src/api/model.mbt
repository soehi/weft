///|
/// Machine-readable location. A field is a manifest location, not a byte offset.
pub(all) struct Location {
  component : String?
  port : String?
  field : String?
} derive(Eq, Debug)

///|
/// One failure. Branch on code, never parse message or detail for control flow.
pub(all) struct Diagnostic {
  code : String
  stage : String
  message : String
  location : Location
  related : Array[Location]
  detail : String?
} derive(Eq, Debug)

///|
/// Canonical JSON is generated by the same emitter used by the CLI.
pub(all) struct Output {
  plan : @plan.Plan
  json : String
}

///|
pub extend Location with Eq::{equal, not_equal}

///|
pub extend Location with Debug::{to_repr}

///|
pub extend Diagnostic with Eq::{equal, not_equal}

///|
pub extend Diagnostic with Debug::{to_repr}
